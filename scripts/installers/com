#!/bin/sh
# `com` launcher of the standalone install (scripts/build-installers.ts): runs the CLI on the Bun and
# the engine shipped next to it, so the machine needs neither Node, npm nor Bun.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)

export COM_BUN="${COM_BUN:-$dir/runtime/bun}"
export COM_COMPILER_PATH="${COM_COMPILER_PATH:-$dir/runtime/com-compiler}"
exec "$dir/runtime/bun" "$dir/lib/bin/cli.ts" "$@"
