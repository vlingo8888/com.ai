    { "name": "route handler GET with query", "path": "/api/hello?name=com", "api": { "status": 200, "json": { "message": "hello com" } } },
    { "name": "route handler POST with JSON body", "path": "/api/hello", "api": { "method": "POST", "body": { "a": 1 }, "status": 201, "json": { "received": { "a": 1 } } } }
