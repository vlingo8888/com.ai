    { "name": "catch-all segment", "path": "/docs/getting/started/install", "status": 200, "ssr": ["Docs path: getting / started / install"] },
    { "name": "route group + template.tsx", "path": "/pricing", "status": 200, "ssr": ["Pricing plans"], "title": "Pricing · Routing", "selector": "[data-template=marketing]" },
